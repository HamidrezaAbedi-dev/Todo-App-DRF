# Django core
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# PostgreSQL
# These values configure both the PostgreSQL container and Django connection.
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email (smtp4dev in the Docker Compose development environment)
EMAIL_HOST=smtp4dev
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional Django development and API documentation tools
SHOW_DEBUGGER_TOOLBAR=False
SHOW_SWAGGER=True

# Simple JWT token lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Browser authentication cookie settings
# Leave AUTH_COOKIE_DOMAIN commented for a host-only cookie.
# Set AUTH_COOKIE_SECURE=True when serving the site over HTTPS.
# Allowed SameSite values are Strict, Lax, and None.
# AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_CSRF_AUTHENTICATION=False

# For production, use a unique secret, DEBUG=False, a restricted ALLOWED_HOSTS,
# HTTPS, and AUTH_COOKIE_SECURE=True.
